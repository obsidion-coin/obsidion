# systemd unit for an Obsidion seed node.
#
# Install on a Linux VPS:
#
#   sudo useradd --system --create-home --home-dir /var/lib/obsidion obsidion
#   sudo cp deploy/obsidion.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now obsidion
#   sudo journalctl -u obsidion -f          # watch it run
#
# **This node carries no wallet.** A seed relays blocks and transactions; it
# never mines and never spends, so it has no use for keys — and a machine
# facing the open internet with no keys on it is a machine with nothing worth
# stealing. There is no password to set and no credential file to protect.
#
# To mine, run a separate node on your own machine with --wallet and --mine.
# That one needs no inbound connectivity at all; see the README.

[Unit]
Description=Obsidion (OBSD) full node
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=obsidion
Group=obsidion
WorkingDirectory=/var/lib/obsidion/obsidion

# Without this, Python buffers stdout when it is not a terminal and the
# start-up banner never reaches journalctl — so a node that came up fine looks
# like one that hung.
Environment=PYTHONUNBUFFERED=1

# No --wallet and no --mine: this node relays, and nothing else.
ExecStart=/var/lib/obsidion/obsidion/.venv/bin/python -m obsidion.node \
    --network mainnet \
    --datadir /var/lib/obsidion/data \
    --host 0.0.0.0 \
    --port 9444

Restart=always
RestartSec=10

# A seed node holds real keys and faces the open internet. Give it as little
# of the machine as it can do its job with.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/obsidion
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
MemoryMax=2G

[Install]
WantedBy=multi-user.target
