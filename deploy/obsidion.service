# systemd unit for an Obsidion seed node.
#
# Install on a Linux VPS:
#
#   sudo useradd --system --create-home --home-dir /var/lib/obsidion obsidion
#   sudo cp deploy/obsidion.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now obsidion
#   sudo journalctl -u obsidion -f          # watch it run
#
# The wallet password is read from /etc/obsidion/password, which must be
# readable only by the service user:
#
#   sudo mkdir -p /etc/obsidion
#   printf 'your-password' | sudo tee /etc/obsidion/password > /dev/null
#   sudo chown obsidion:obsidion /etc/obsidion/password
#   sudo chmod 600 /etc/obsidion/password

[Unit]
Description=Obsidion (OBSD) full node
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=obsidion
Group=obsidion
WorkingDirectory=/var/lib/obsidion/obsidion

# The password file is loaded as an environment file, so it must contain
# exactly: OBSIDION_WALLET_PASSWORD=...
EnvironmentFile=/etc/obsidion/password

# Without this, Python buffers stdout when it is not a terminal and the
# start-up banner never reaches journalctl — so a node that came up fine looks
# like one that hung.
Environment=PYTHONUNBUFFERED=1

ExecStart=/var/lib/obsidion/obsidion/.venv/bin/python -m obsidion.node \
    --network mainnet \
    --datadir /var/lib/obsidion/data \
    --wallet /var/lib/obsidion/data/node.wallet \
    --create-wallet \
    --host 0.0.0.0 \
    --port 9444

Restart=always
RestartSec=10

# A seed node holds real keys and faces the open internet. Give it as little
# of the machine as it can do its job with.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/obsidion
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
MemoryMax=2G

[Install]
WantedBy=multi-user.target
