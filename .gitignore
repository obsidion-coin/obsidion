# Virtual environment
.venv/
venv/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
build/
dist/

# Chain data and wallets — NEVER commit these
*.db
*.db-journal
*.db-wal
*.db-shm
data/
# Match the wallet file AND any backup/dated copy of it. Plain "*.wallet"
# misses "mainnet.wallet.backup" and "mainnet.wallet.bak-2026-08-07", so a
# stray `git add -A` could publish an encrypted keystore. The `*.wallet*`
# glob closes that.
*.wallet
*.wallet.*
*.wallet-*
wallet.json
*.key

# OS
Thumbs.db
desktop.ini
.DS_Store
